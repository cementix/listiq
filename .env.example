# Copy to .env. Never commit actual secrets or a provider's pulled environment.
# Application uses pooled Postgres; migrations use the direct URL for that DB.
DATABASE_URL=postgresql://listiq:CHANGE_ME@127.0.0.1:5432/listiq
DATABASE_URL_UNPOOLED=postgresql://listiq:CHANGE_ME@127.0.0.1:5432/listiq
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES

# Required even for local cron invocations. Generate independently per environment.
CRON_SECRET=REPLACE_WITH_A_RANDOM_CRON_SECRET

# Optional until image uploads are used.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=listiq

# Catalog imports only. AniList is disabled until provider permission is obtained.
ANILIST_API_PERMISSION_CONFIRMED=false
GOOGLE_BOOKS_CATALOG_PERMISSION_CONFIRMED=false
COMIC_VINE_CATALOG_PERMISSION_CONFIRMED=false
TMDB_ACCESS_TOKEN=
RAWG_API_KEY=
CATALOG_REPLACEMENTS_DAILY=false
OPEN_LIBRARY_CATALOG_PERMISSION_CONFIRMED=false
OPEN_LIBRARY_CONTACT=
GOOGLE_BOOKS_API_KEY=
COMICVINE_API_KEY=
COMICVINE_USER_AGENT=Listiq/0.1

# Optional HTTPS receiver for sanitized error/failure events (no PII or secrets).
MONITORING_WEBHOOK_URL=

# Telegram alerts (alternative/addition to the HTTPS receiver). Server-only.
# Create a bot using @BotFather, then send /start to that bot before testing.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Operator-only: never use the application/production database as the demo target.
DEMO_DATABASE_URL=
DEMO_PASSWORD=
# Integration tests require a LOCAL PostgreSQL role with CREATEDB.
TEST_DATABASE_ADMIN_URL=
# Optional PostgreSQL binaries override for backup verification.
# PG_BIN=C:/Program Files/PostgreSQL/18/bin
