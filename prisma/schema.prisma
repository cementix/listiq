generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
  VERIFIED
}

enum TitleType {
  MOVIE
  SERIES
  ANIME
  MANGA
  MANHWA
  BOOK
  GAME
  NOVEL
  COMIC
  OTHER
}

enum SubmissionStatus {
  PENDING
  NEEDS_CHANGES
  RESUBMITTED
  APPROVED
  REJECTED
}

enum ActivityEventType {
  TITLE_ADDED
  TITLE_REMOVED
  TITLE_RATED
  TITLE_REVIEWED
  TITLE_SUBMITTED
}

enum ProfilePostMediaType {
  IMAGE
  VIDEO
}

enum NotificationType {
  PROFILE_POST_COMMENT
  PROFILE_POST_REPLY
  PROFILE_POST_COMMENT_LIKE
}

enum ExternalTitleProvider {
  RAWG
  TMDB_MOVIE
  TMDB_TV
  ANILIST
  GOOGLE_BOOKS
  OPEN_LIBRARY
  COMIC_VINE
}

enum SyncRunStatus {
  RUNNING
  SUCCESS
  FAILED
}

enum TitleAliasKind {
  PRIMARY
  ENGLISH
  ORIGINAL
  NATIVE
  ROMAJI
  SYNONYM
  SLUG
}

enum TitleListVisibility {
  PUBLIC
  PRIVATE
}

enum TitleListSystemType {
  SAVE_FOR_LATER
}

enum DiscoveryAction {
  SKIPPED
  SAVED_FOR_LATER
  ADDED_TO_LIBRARY
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  role         UserRole @default(USER)

  avatarUrl      String?
  avatarPublicId String?
  bannerUrl      String?
  bannerPublicId String?

  privacySetupCompleted Boolean @default(false)
  libraryPublic         Boolean @default(false)
  reviewsPublic         Boolean @default(false)
  statsPublic           Boolean @default(false)
  postsPublic           Boolean @default(false)
  titleActivityPublic   Boolean @default(false)
  listActivityPublic    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdTitles   Title[]          @relation("TitleCreator")
  library         UserTitle[]
  titleLists      TitleList[]
  savedTitleLists SavedTitleList[]

  activityEvents ActivityEvent[]

  submissions  TitleSubmission[] @relation("SubmissionAuthor")
  reviewedSubs TitleSubmission[] @relation("SubmissionReviewer")

  profilePosts            ProfilePost[]
  profilePostLikes        ProfilePostLike[]
  profilePostComments     ProfilePostComment[]
  profilePostCommentLikes ProfilePostCommentLike[]

  notificationsReceived Notification[]       @relation("NotificationRecipient")
  notificationsSent     Notification[]       @relation("NotificationActor")
  userTitleDiscoveries  UserTitleDiscovery[]
  uploadedAssets        UploadedAsset[]
}

model UploadedAsset {
  publicId String @id
  userId   String
  user     User @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose  String
  type     ProfilePostMediaType
  url      String
  width    Int
  height   Int
  bytes    Int
  createdAt DateTime @default(now())

  @@index([userId, purpose])
}

model RateLimitBucket {
  key       String @id
  count     Int
  expiresAt DateTime

  @@index([expiresAt])
}

model Title {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  year          Int?
  description   String?
  imageUrl      String?
  imagePublicId String?
  type          TitleType

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdById String?
  createdBy   User?   @relation("TitleCreator", fields: [createdById], references: [id], onDelete: SetNull)

  releaseDate DateTime?
  backdropUrl String?

  // Provider-normalized score; user ratings are stored separately.
  catalogScore    Float?
  catalogEligible Boolean   @default(false)
  catalogScoredAt DateTime?

  genres         Genre[]
  users          UserTitle[]
  discoveries    UserTitleDiscovery[]
  activityEvents ActivityEvent[]
  externalTitles ExternalTitle[]
  aliases        TitleAlias[]
  listItems      TitleListItem[]

  @@index([name])
  @@index([type])
  @@index([year])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Title_name_trgm_idx")
  @@index([catalogEligible, catalogScore(sort: Desc)])
  @@index([type, catalogEligible, catalogScore(sort: Desc)])
}

model Genre {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  titles      Title[]
  submissions TitleSubmission[]
}

model UserTitle {
  id String @id @default(cuid())

  userId  String
  titleId String

  rating Float?
  note   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title                Title         @relation(fields: [titleId], references: [id], onDelete: Cascade)
  attachedProfilePosts ProfilePost[]

  @@unique([userId, titleId])
  @@index([userId])
  @@index([titleId])
}

model UserTitleDiscovery {
  id String @id @default(cuid())

  userId  String
  titleId String

  shownCount  Int       @default(0)
  lastShownAt DateTime?
  skipCount   Int       @default(0)

  // The last choice is history, not current library or list membership.
  lastAction   DiscoveryAction?
  lastActionAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  title Title @relation(fields: [titleId], references: [id], onDelete: Cascade)

  @@unique([userId, titleId])
  @@index([userId, lastShownAt])
  @@index([titleId])
}

model TitleSubmission {
  id            String    @id @default(cuid())
  name          String
  year          Int?
  description   String?
  imageUrl      String?
  imagePublicId String?
  type          TitleType

  activityEvents ActivityEvent[]

  status        SubmissionStatus @default(PENDING)
  reviewComment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submittedById String
  submittedBy   User   @relation("SubmissionAuthor", fields: [submittedById], references: [id], onDelete: Cascade)

  reviewedById String?
  reviewedBy   User?   @relation("SubmissionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  genres Genre[]

  @@index([status])
  @@index([name])
  @@index([submittedById, status])
}

model ActivityEvent {
  id String @id @default(cuid())

  userId       String
  titleId      String?
  submissionId String?

  type   ActivityEventType
  rating Float?
  note   String?

  createdAt DateTime @default(now())

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      Title?           @relation(fields: [titleId], references: [id], onDelete: SetNull)
  submission TitleSubmission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([titleId])
  @@index([submissionId])
}

model ProfilePost {
  id String @id @default(cuid())

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  content String?

  attachedUserTitleId String?
  attachedUserTitle   UserTitle? @relation(fields: [attachedUserTitleId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  media         ProfilePostMedia[]
  likes         ProfilePostLike[]
  comments      ProfilePostComment[]
  notifications Notification[]

  @@index([authorId, createdAt])
  @@index([attachedUserTitleId])
}

model ProfilePostMedia {
  id String @id @default(cuid())

  postId String
  post   ProfilePost @relation(fields: [postId], references: [id], onDelete: Cascade)

  type     ProfilePostMediaType
  url      String
  publicId String?

  width  Int?
  height Int?

  createdAt DateTime @default(now())

  @@index([postId])
}

model ProfilePostLike {
  id String @id @default(cuid())

  postId String
  post   ProfilePost @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([userId])
}

model ProfilePostComment {
  id String @id @default(cuid())

  postId String
  post   ProfilePost @relation(fields: [postId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  parentId String?
  parent   ProfilePostComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  ProfilePostComment[] @relation("CommentReplies")

  content String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notifications Notification[]
  likes         ProfilePostCommentLike[]

  @@index([postId, createdAt])
  @@index([authorId])
  @@index([parentId])
}

model ProfilePostCommentLike {
  id String @id @default(cuid())

  commentId String
  comment   ProfilePostComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([commentId, userId])
  @@index([userId])
}

model Notification {
  id String @id @default(cuid())

  recipientId String
  recipient   User   @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  actorId String
  actor   User   @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)

  type   NotificationType
  readAt DateTime?

  postId String?
  post   ProfilePost? @relation(fields: [postId], references: [id], onDelete: Cascade)

  commentId String?
  comment   ProfilePostComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([recipientId, readAt, createdAt])
  @@index([actorId])
  @@index([postId])
  @@index([commentId])
}

model ExternalTitle {
  id String @id @default(cuid())

  titleId String
  title   Title  @relation(fields: [titleId], references: [id], onDelete: Cascade)

  provider    ExternalTitleProvider
  externalId  String
  externalUrl String?

  // Comparable source metrics are extracted from rawData during sync.
  sourcePopularity  Float?
  sourceRating      Float?
  sourceRatingCount Int?

  rawData      Json?
  lastSyncedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, externalId])
  @@index([titleId])
}

model SyncRun {
  id String @id @default(cuid())

  provider ExternalTitleProvider?
  status   SyncRunStatus

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  titlesCreated Int @default(0)
  titlesUpdated Int @default(0)

  errorMessage String?

  @@index([provider, startedAt])
  @@index([status, startedAt])
}

model TitleAlias {
  id      String @id @default(cuid())
  titleId String
  title   Title  @relation(fields: [titleId], references: [id], onDelete: Cascade)

  value           String
  normalizedValue String
  kind            TitleAliasKind
  source          ExternalTitleProvider?

  createdAt DateTime @default(now())

  @@unique([titleId, normalizedValue, kind])
  @@index([normalizedValue])
  @@index([titleId])
  @@index([normalizedValue(ops: raw("gin_trgm_ops"))], type: Gin, map: "TitleAlias_normalizedValue_trgm_idx")
}

model TitleList {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String
  slug        String
  description String?

  savedBy SavedTitleList[]

  visibility TitleListVisibility  @default(PUBLIC)
  systemType TitleListSystemType?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items TitleListItem[]

  @@unique([userId, slug])
  @@unique([userId, systemType])
  @@index([userId, createdAt])
  @@index([visibility, createdAt])
}

model TitleListItem {
  id String @id @default(cuid())

  listId String
  list   TitleList @relation(fields: [listId], references: [id], onDelete: Cascade)

  titleId String
  title   Title  @relation(fields: [titleId], references: [id], onDelete: Cascade)

  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([listId, titleId])
  @@index([listId, position])
  @@index([titleId])
}

model SavedTitleList {
  id        String   @id @default(cuid())
  userId    String
  listId    String
  createdAt DateTime @default(now())

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  list TitleList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([userId, listId])
  @@index([userId, createdAt])
  @@index([listId])
}
