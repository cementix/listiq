generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
  VERIFIED
}

enum TitleType {
  MOVIE
  SERIES
  ANIME
  MANGA
  MANHWA
  BOOK
  GAME
  NOVEL
  COMIC
  OTHER
}

enum SubmissionStatus {
  PENDING
  NEEDS_CHANGES
  RESUBMITTED
  APPROVED
  REJECTED
}

enum ActivityEventType {
  TITLE_ADDED
  TITLE_REMOVED
  TITLE_RATED
  TITLE_REVIEWED
  TITLE_SUBMITTED
}

enum ProfilePostMediaType {
  IMAGE
  VIDEO
}

enum NotificationType {
  PROFILE_POST_COMMENT
  PROFILE_POST_REPLY
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  role         UserRole @default(USER)

  avatarUrl      String?
  avatarPublicId String?
  bannerUrl      String?
  bannerPublicId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdTitles Title[]     @relation("TitleCreator")
  library       UserTitle[]

  activityEvents ActivityEvent[]

  submissions  TitleSubmission[] @relation("SubmissionAuthor")
  reviewedSubs TitleSubmission[] @relation("SubmissionReviewer")

  profilePosts        ProfilePost[]
  profilePostLikes    ProfilePostLike[]
  profilePostComments ProfilePostComment[]

  notificationsReceived Notification[] @relation("NotificationRecipient")
  notificationsSent     Notification[] @relation("NotificationActor")
}

model Title {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  year          Int?
  description   String?
  imageUrl      String?
  imagePublicId String?
  type          TitleType

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdById String?
  createdBy   User?   @relation("TitleCreator", fields: [createdById], references: [id], onDelete: SetNull)

  genres         Genre[]
  users          UserTitle[]
  activityEvents ActivityEvent[]

  @@index([name])
  @@index([type])
  @@index([year])
}

model Genre {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  titles      Title[]
  submissions TitleSubmission[]
}

model UserTitle {
  id String @id @default(cuid())

  userId  String
  titleId String

  rating Float?
  note   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title                Title         @relation(fields: [titleId], references: [id], onDelete: Cascade)
  attachedProfilePosts ProfilePost[]

  @@unique([userId, titleId])
  @@index([userId])
  @@index([titleId])
}

model TitleSubmission {
  id            String    @id @default(cuid())
  name          String
  year          Int?
  description   String?
  imageUrl      String?
  imagePublicId String?
  type          TitleType

  activityEvents ActivityEvent[]

  status        SubmissionStatus @default(PENDING)
  reviewComment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submittedById String
  submittedBy   User   @relation("SubmissionAuthor", fields: [submittedById], references: [id], onDelete: Cascade)

  reviewedById String?
  reviewedBy   User?   @relation("SubmissionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  genres Genre[]

  @@index([status])
  @@index([name])
  @@index([submittedById, status])
}

model ActivityEvent {
  id String @id @default(cuid())

  userId       String
  titleId      String?
  submissionId String?

  type   ActivityEventType
  rating Float?
  note   String?

  createdAt DateTime @default(now())

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      Title?           @relation(fields: [titleId], references: [id], onDelete: SetNull)
  submission TitleSubmission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([titleId])
  @@index([submissionId])
}

model ProfilePost {
  id String @id @default(cuid())

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  content String?

  attachedUserTitleId String?
  attachedUserTitle   UserTitle? @relation(fields: [attachedUserTitleId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  media         ProfilePostMedia[]
  likes         ProfilePostLike[]
  comments      ProfilePostComment[]
  notifications Notification[]

  @@index([authorId, createdAt])
  @@index([attachedUserTitleId])
}

model ProfilePostMedia {
  id String @id @default(cuid())

  postId String
  post   ProfilePost @relation(fields: [postId], references: [id], onDelete: Cascade)

  type     ProfilePostMediaType
  url      String
  publicId String?

  width  Int?
  height Int?

  createdAt DateTime @default(now())

  @@index([postId])
}

model ProfilePostLike {
  id String @id @default(cuid())

  postId String
  post   ProfilePost @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([userId])
}

model ProfilePostComment {
  id String @id @default(cuid())

  postId String
  post   ProfilePost @relation(fields: [postId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  parentId String?
  parent   ProfilePostComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  ProfilePostComment[] @relation("CommentReplies")

  content String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notifications Notification[]

  @@index([postId, createdAt])
  @@index([authorId])
  @@index([parentId])
}

model Notification {
  id String @id @default(cuid())

  recipientId String
  recipient   User   @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  actorId String
  actor   User   @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)

  type   NotificationType
  readAt DateTime?

  postId String?
  post   ProfilePost? @relation(fields: [postId], references: [id], onDelete: Cascade)

  commentId String?
  comment   ProfilePostComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([recipientId, readAt, createdAt])
  @@index([actorId])
  @@index([postId])
  @@index([commentId])
}
