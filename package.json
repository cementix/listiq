{
  "name": "listiq",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build --webpack",
    "vercel-build": "prisma generate && prisma migrate deploy && next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node --import tsx --import ./tests/register-server-only.mjs --test tests/*.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "test:neon": "tsx scripts/smoke-neon.ts",
    "test:ui": "node --import tsx --test tests/ui.test.ts",
    "test:integration": "node tests/integration/run.mjs",
    "test:mutations": "node --import tsx --import ./tests/register-server-only.mjs --test tests/mutations.test.ts",
    "test:catalog": "node --import tsx --test tests/catalog.test.ts",
    "test:security": "node --import tsx --import ./tests/register-server-only.mjs --test tests/security.test.ts",
    "sync:titles": "tsx scripts/syncTitles.ts daily",
    "sync:titles:daily": "tsx scripts/syncTitles.ts daily",
    "sync:titles:deep": "tsx scripts/syncTitles.ts deep",
    "sync:titles:tmdb": "tsx scripts/syncTitles.ts deep tmdb",
    "sync:titles:rawg": "tsx scripts/syncTitles.ts deep rawg",
    "sync:titles:anilist": "tsx scripts/syncTitles.ts deep anilist",
    "sync:titles:books": "tsx scripts/syncTitles.ts deep google-books",
    "sync:titles:comics": "tsx scripts/syncTitles.ts deep comic-vine",
    "lint:profile-posts": "eslint \"actions/profile\" \"app/(protected)/users/[username]/ProfilePosts\"",
    "lint:profile": "eslint \"actions/profile\" \"app/(protected)/users/[username]\"",
    "lint:profile-posts:fix": "eslint \"actions/profile\" \"app/(protected)/users/[username]/ProfilePosts\" --fix"
  },
  "dependencies": {
    "@dnd-kit/react": "^0.5.0",
    "@hookform/resolvers": "^5.2.2",
    "@neon/config": "^1.9.4",
    "@neon/env": "^1.6.5",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@reduxjs/toolkit": "^2.12.0",
    "@vercel/functions": "^3.10.3",
    "bcrypt": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.9.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "jose": "^6.2.1",
    "lucide-react": "^0.577.0",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "ogl": "^1.0.11",
    "pg": "^8.20.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-easy-crop": "^5.5.7",
    "react-hook-form": "^7.71.2",
    "react-redux": "^9.3.0",
    "shadcn": "^4.0.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
